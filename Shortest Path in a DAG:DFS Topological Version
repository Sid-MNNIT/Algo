class Solution {
    void dfs(int node, vector<pair<int,int>> adj[],
             vector<int> &vis, stack<int> &st){

        vis[node] = 1;

        for(auto &it : adj[node]){
            if(!vis[it.first])
                dfs(it.first, adj, vis, st);
        }

        st.push(node);
    }

public:
    vector<int> shortestPath(int N, int M, vector<vector<int>>& edges) {

        vector<pair<int,int>> adj[N];

        for(auto &e : edges){
            adj[e[0]].push_back({e[1], e[2]});
        }

        vector<int> vis(N,0);
        stack<int> st;

        for(int i=0;i<N;i++)
            if(!vis[i])
                dfs(i,adj,vis,st);

        vector<int> dist(N,INT_MAX);
        dist[0]=0;

        while(!st.empty()){

            int node=st.top();
            st.pop();

            if(dist[node]==INT_MAX)
                continue;

            for(auto &it:adj[node]){

                int v=it.first;
                int wt=it.second;

                dist[v]=min(dist[v],dist[node]+wt);
            }
        }

        for(int i=0;i<N;i++)
            if(dist[i]==INT_MAX)
                dist[i]=-1;

        return dist;
    }
};
