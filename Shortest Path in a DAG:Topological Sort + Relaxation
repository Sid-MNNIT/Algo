class Solution {
public:
    vector<int> shortestPath(int N, int M, vector<vector<int>>& edges) {

        vector<pair<int,int>> adj[N];

        for(auto &e : edges){
            int u = e[0];
            int v = e[1];
            int wt = e[2];

            adj[u].push_back({v, wt});
        }

        // ---------- Topological Sort ----------
        vector<int> indegree(N, 0);

        for(int u = 0; u < N; u++){
            for(auto &it : adj[u]){
                indegree[it.first]++;
            }
        }

        queue<int> q;

        for(int i = 0; i < N; i++){
            if(indegree[i] == 0)
                q.push(i);
        }

        vector<int> topo;

        while(!q.empty()){
            int node = q.front();
            q.pop();

            topo.push_back(node);

            for(auto &it : adj[node]){
                indegree[it.first]--;

                if(indegree[it.first] == 0)
                    q.push(it.first);
            }
        }

        // ---------- Shortest Path ----------
        vector<int> dist(N, INT_MAX);

        dist[0] = 0;       // source = 0

        for(int node : topo){

            if(dist[node] == INT_MAX)
                continue;

            for(auto &it : adj[node]){
                int v = it.first;
                int wt = it.second;

                if(dist[node] + wt < dist[v]){
                    dist[v] = dist[node] + wt;
                }
            }
        }

        for(int i = 0; i < N; i++){
            if(dist[i] == INT_MAX)
                dist[i] = -1;
        }

        return dist;
    }
};
